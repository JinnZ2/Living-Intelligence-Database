{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plant Intelligence Schema",
  "type": "object",
  "required": ["id", "name", "ontology"],
  "properties": {
    "id": { "type": "string" },
    "emoji": { "type": "string" },
    "name": { "type": "string" },
    "ontology": { "const": "plant" },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "function": { "type": "string" },
          "efficiency_factor": { "type": "number" },
          "relations": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "root_networks": { "type": "boolean" },
    "symbioses": { "type": "array", "items": { "type": "string" } },
    "entropy_profile": {
      "type": "object",
      "description": "Characterizes the entity's relationship to order and change.",
      "properties": {
        "stability":    { "type": "string", "enum": ["low", "medium", "high"] },
        "adaptability": { "type": "string", "enum": ["low", "medium", "high"] },
        "archetype":    { "type": "string", "enum": ["chassis", "engine", "bridge", "cycle", "sensor"] }
      }
    },
    "substrate_layer": {
      "type": "string",
      "description": "Primary cognitive architecture. Drives architecture_mismatch warnings.",
      "enum": ["language_primary", "substrate_primary", "both"]
    },
    "metadata": { "type": "object" }
  }
}
