{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Energy Intelligence Schema",
  "type": "object",
  "required": ["id", "name", "ontology"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "ontology": { "const": "energy" },
    "transmission_modes": { "type": "array", "items": { "type": "string" } },
    "conversion_efficiency": { "type": "number" },
    "pattern_couplings": { "type": "array", "items": { "type": "string" } },
    "entropy_profile": {
      "type": "object",
      "description": "Characterizes the entity's relationship to order and change. Energy archetypes are often 'engine' (high adaptability, drives transformation).",
      "properties": {
        "stability":    { "type": "string", "enum": ["low", "medium", "high"] },
        "adaptability": { "type": "string", "enum": ["low", "medium", "high"] },
        "archetype":    { "type": "string", "enum": ["chassis", "engine", "bridge", "cycle", "sensor"] }
      }
    },
    "substrate_layer": {
      "type": "string",
      "description": "Primary cognitive architecture. Drives architecture_mismatch warnings.",
      "enum": ["language_primary", "substrate_primary", "both"]
    },
    "metadata": { "type": "object" }
  }
}
