{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Shape Intelligence Schema",
  "type": "object",
  "required": ["id", "name", "ontology"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "emoji": { "type": "string" },
    "ontology": { "const": "shape" },
    "geometry_class": { "type": "string" },
    "dimension": { "type": "integer" },
    "harmonic_ratios": { "type": "array", "items": { "type": "number" } },
    "applications": { "type": "array", "items": { "type": "string" } },
    "entropy_profile": {
      "type": "object",
      "description": "Characterizes the entity's relationship to order and change. Shape archetypes are typically 'chassis' — geometry is invariant, it is the stable substrate others build on.",
      "properties": {
        "stability":    { "type": "string", "enum": ["low", "medium", "high"] },
        "adaptability": { "type": "string", "enum": ["low", "medium", "high"] },
        "archetype":    { "type": "string", "enum": ["chassis", "engine", "bridge", "cycle", "sensor"] }
      }
    },
    "substrate_layer": {
      "type": "string",
      "description": "Primary cognitive architecture. Drives architecture_mismatch warnings.",
      "enum": ["language_primary", "substrate_primary", "both"]
    },
    "metadata": { "type": "object" }
  }
}
