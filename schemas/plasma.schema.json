{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plasma Intelligence Schema",
  "type": "object",
  "required": ["id", "name", "ontology"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "ontology": { "const": "plasma" },
    "field_dynamics": { "type": "string" },
    "charge_modes": { "type": "array", "items": { "type": "string" } },
    "coherence_states": { "type": "array", "items": { "type": "string" } },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["relation", "target"],
        "properties": {
          "relation": { "type": "string" },
          "target": { "type": "string" }
        }
      }
    },
    "entropy_profile": {
      "type": "object",
      "description": "Characterizes the entity's relationship to order and change. Plasma archetypes are often 'engine' — high energy, variable entropy.",
      "properties": {
        "stability":    { "type": "string", "enum": ["low", "medium", "high"] },
        "adaptability": { "type": "string", "enum": ["low", "medium", "high"] },
        "archetype":    { "type": "string", "enum": ["chassis", "engine", "bridge", "cycle", "sensor"] }
      }
    },
    "substrate_layer": {
      "type": "string",
      "description": "Primary cognitive architecture. Drives architecture_mismatch warnings.",
      "enum": ["language_primary", "substrate_primary", "both"]
    },
    "metadata": { "type": "object" }
  }
}
