{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "provenance.schema.json",
  "title": "provenance",
  "description": "Provenance chain for one entity: a list of hashed steps, append-only. The chain is stored in provenance/<entity_id>.json; an entity file may carry the same block, or null, or leave the key out. Null means no information. See docs/provenance.md.",
  "type": [
    "object",
    "null"
  ],
  "additionalProperties": false,
  "required": [
    "entity",
    "path",
    "snapshot_class",
    "steps"
  ],
  "properties": {
    "entity": {
      "type": "string"
    },
    "path": {
      "type": "string"
    },
    "snapshot_class": {
      "enum": [
        "CONTEXT_FREE_EXACT",
        "STABLE_LOSSY",
        "CHAOTIC_REFRESH",
        "SUMMARY_ONLY",
        null
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "inputs",
          "method",
          "params",
          "value",
          "assumptions",
          "scope",
          "status",
          "supersedes",
          "declared_pre_run",
          "claim",
          "void",
          "snapshot_class"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "sha256 of the canonical JSON of {inputs, method, params, value}."
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Parent step ids or source ids (S-...). Empty when the field has no source."
          },
          "method": {
            "type": "object",
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          },
          "params": {
            "type": "object",
            "description": "Always holds entity and field."
          },
          "value": {
            "description": "The field's value as found. Null when the field is null."
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^A-[0-9a-f]{12}$"
            },
            "description": "Ids in registry/assumptions.json."
          },
          "scope": {
            "type": [
              "object",
              "null"
            ],
            "description": "Conditions the value holds under, as recorded. Null = none recorded."
          },
          "status": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^(OBSERVED|PROPOSED|DERIVED|DERIVED \\(basis: (OBSERVED|PROPOSED|DERIVED)\\))$",
            "description": "The field's existing tag. Null = the field carries none."
          },
          "supersedes": {
            "type": [
              "string",
              "null"
            ],
            "description": "Prior step id this one revises, or null. The prior step stays in the file."
          },
          "declared_pre_run": {
            "type": [
              "string",
              "null"
            ],
            "description": "Commit that added registry/DECLARED.json."
          },
          "claim": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "statement",
              "evidence",
              "refuter",
              "state"
            ],
            "properties": {
              "statement": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              },
              "refuter": {
                "type": "string"
              },
              "state": {
                "enum": [
                  "SUPPORTED",
                  "UNVERIFIED"
                ]
              }
            },
            "description": "Separate from status. Null on every backfilled step."
          },
          "void": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "state",
              "reason"
            ],
            "properties": {
              "state": {
                "enum": [
                  "REJECTED",
                  "UNMAPPED",
                  "LEXICAL_VOID",
                  "VOID"
                ]
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "snapshot_class": {
            "enum": [
              "CONTEXT_FREE_EXACT",
              "STABLE_LOSSY",
              "CHAOTIC_REFRESH",
              "SUMMARY_ONLY",
              null
            ],
            "description": "Set on a summarized or coarse record; null otherwise."
          }
        }
      }
    }
  }
}
