{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jinnz2.github.io/Living-Intelligence-Database/schema/intelligence.schema.json",
  "title": "Living Intelligence Node",
  "type": "object",
  "required": ["id", "kind", "label"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
    "kind": {
      "type": "string",
      "enum": ["ANIMAL", "PLANT", "CRYSTAL", "PLASMA", "ENERGY", "SHAPE"]
    },
    "label": { "type": "string", "minLength": 1 },
    "attributes": {
      "type": "object",
      "description": "Freeform but structured where possible.",
      "properties": {
        "pattern": { "type": "string" },
        "domain": { "type": "string" },
        "geometry": { "type": "string" },
        "frequency": { "type": ["number", "string"] },
        "resonance": { "type": ["number", "string"] },
        "constraints": {
          "type": "object",
          "description": "Constants/temporal/protocol hints live here (keeps repo to the 6 kinds).",
          "properties": {
            "phi": { "type": ["number", "string"] },
            "tau": { "type": ["number", "string"] },
            "temporal": { "type": "string" },
            "protocols": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rel", "to"],
        "properties": {
          "rel": { "type": "string" },
          "to": { "type": "string" }
        }
      }
    },
    "coordination": {
      "title": "Coordination block",
      "description": "How an entity coordinates exchange without assuming money, language or a central planner. Every field is nullable. Null means no information: keep the key, never drop it. See docs/coordination_layer.md.",
      "type": ["object", "null"],
      "required": [
        "carrier",
        "signal",
        "record",
        "closure",
        "trust_basis",
        "energy_cost",
        "loop_topology",
        "assumption_trace",
        "sources",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "carrier": {
          "type": [
            "string",
            "null"
          ],
          "description": "Physical token exchanged (carbon, pheromone, phase, shell and art)."
        },
        "signal": {
          "type": [
            "string",
            "null"
          ],
          "description": "How need or offer is sensed (gradient, quorum, dance)."
        },
        "record": {
          "type": [
            "string",
            "null"
          ],
          "description": "Where the state lives (environment, body, shared object)."
        },
        "closure": {
          "type": [
            "string",
            "null"
          ],
          "description": "How an exchange completes and becomes visible."
        },
        "trust_basis": {
          "type": [
            "string",
            "null"
          ],
          "description": "What accumulates (completed cycles, reinforcement)."
        },
        "energy_cost": {
          "description": "Upkeep of the coordination itself. joules is a number only if a source measured it; otherwise null with note 'unmeasured'.",
          "type": [
            "object",
            "null"
          ],
          "required": [
            "joules",
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "joules": {
              "type": [
                "number",
                "null"
              ]
            },
            "per": {
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "loop_topology": {
          "description": "Cycles in the exchange, and which of them survive common observer cuts. A cut that removes a cycle can read that cycle's cost as 0.",
          "type": [
            "object",
            "null"
          ],
          "required": [
            "cycles",
            "observer_cuts"
          ],
          "additionalProperties": false,
          "properties": {
            "cycles": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "path"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "path": {
                    "type": "string"
                  }
                }
              }
            },
            "observer_cuts": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "object",
                "required": [
                  "cut",
                  "cycles_surviving"
                ],
                "additionalProperties": false,
                "properties": {
                  "cut": {
                    "type": "string"
                  },
                  "cycles_surviving": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "note": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            }
          }
        },
        "assumption_trace": {
          "description": "Corpus assumptions this entity tests.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "description": "Citations per field. Key = field name; value = list of citations or null.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "carrier": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "signal": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "record": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "closure": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "trust_basis": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "energy_cost": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "loop_topology": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "assumption_trace": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            }
          }
        },
        "status": {
          "description": "Per field: OBSERVED, DERIVED, PROPOSED, or null where the field has no value. DERIVED may carry the status of what it rests on: 'DERIVED (basis: PROPOSED)' or 'DERIVED (basis: OBSERVED)'.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "carrier": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "OBSERVED",
                "DERIVED",
                "DERIVED (basis: PROPOSED)",
                "DERIVED (basis: OBSERVED)",
                "PROPOSED",
                null
              ]
            },
            "signal": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "OBSERVED",
                "DERIVED",
                "DERIVED (basis: PROPOSED)",
                "DERIVED (basis: OBSERVED)",
                "PROPOSED",
                null
              ]
            },
            "record": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "OBSERVED",
                "DERIVED",
                "DERIVED (basis: PROPOSED)",
                "DERIVED (basis: OBSERVED)",
                "PROPOSED",
                null
              ]
            },
            "closure": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "OBSERVED",
                "DERIVED",
                "DERIVED (basis: PROPOSED)",
                "DERIVED (basis: OBSERVED)",
                "PROPOSED",
                null
              ]
            },
            "trust_basis": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "OBSERVED",
                "DERIVED",
                "DERIVED (basis: PROPOSED)",
                "DERIVED (basis: OBSERVED)",
                "PROPOSED",
                null
              ]
            },
            "energy_cost": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "OBSERVED",
                "DERIVED",
                "DERIVED (basis: PROPOSED)",
                "DERIVED (basis: OBSERVED)",
                "PROPOSED",
                null
              ]
            },
            "loop_topology": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "OBSERVED",
                "DERIVED",
                "DERIVED (basis: PROPOSED)",
                "DERIVED (basis: OBSERVED)",
                "PROPOSED",
                null
              ]
            },
            "assumption_trace": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "OBSERVED",
                "DERIVED",
                "DERIVED (basis: PROPOSED)",
                "DERIVED (basis: OBSERVED)",
                "PROPOSED",
                null
              ]
            }
          }
        },
        "notes": {
          "description": "Optional free text per field, e.g. 'unmeasured', 'unverified: source not opened', 'contested'.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "gate_sensing": {
      "title": "Gate sensing block",
      "description": "How an entity senses an approaching limit and responds before it arrives. Every field is nullable. Null means no information: keep the key, never drop it.",
      "type": ["object", "null"],
      "required": [
        "limit_sensed",
        "early_signal",
        "response",
        "lead_time",
        "status",
        "sources"
      ],
      "additionalProperties": false,
      "properties": {
        "limit_sensed": {
          "type": [
            "string",
            "null"
          ],
          "description": "What approaching constraint is detected."
        },
        "early_signal": {
          "type": [
            "string",
            "null"
          ],
          "description": "How it is detected (slowing recovery, gradient change, habituation, a count of events)."
        },
        "response": {
          "type": [
            "string",
            "null"
          ],
          "description": "Adaptation taken before the limit arrives."
        },
        "lead_time": {
          "description": "Time between the early signal and the limit. value is a number only if a source measured it; otherwise null with a note.",
          "type": [
            "object",
            "null"
          ],
          "required": [
            "value",
            "unit",
            "note"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": [
                "number",
                "null"
              ]
            },
            "unit": {
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "status": {
          "description": "Per field: OBSERVED, DERIVED (optionally with basis), PROPOSED, or null where the field has no value.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "limit_sensed": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "OBSERVED",
                "DERIVED",
                "DERIVED (basis: PROPOSED)",
                "DERIVED (basis: OBSERVED)",
                "PROPOSED",
                null
              ]
            },
            "early_signal": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "OBSERVED",
                "DERIVED",
                "DERIVED (basis: PROPOSED)",
                "DERIVED (basis: OBSERVED)",
                "PROPOSED",
                null
              ]
            },
            "response": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "OBSERVED",
                "DERIVED",
                "DERIVED (basis: PROPOSED)",
                "DERIVED (basis: OBSERVED)",
                "PROPOSED",
                null
              ]
            },
            "lead_time": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "OBSERVED",
                "DERIVED",
                "DERIVED (basis: PROPOSED)",
                "DERIVED (basis: OBSERVED)",
                "PROPOSED",
                null
              ]
            }
          }
        },
        "sources": {
          "description": "Citations per field.",
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "limit_sensed": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "early_signal": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "response": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "lead_time": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "functional_intelligence": {
      "title": "Functional intelligence block",
      "description": "What an entity is observed to do, recorded without requiring a label such as 'intelligent' or 'conscious'. Each capability is yes / no / unmeasured with its own status and source. Null means no information.",
      "type": ["object", "null"],
      "required": [
        "adapts",
        "signals",
        "responds_to_other",
        "changes_environment",
        "co_adapts",
        "coupling_note",
        "contested_label"
      ],
      "additionalProperties": false,
      "properties": {
        "adapts": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "value",
            "status",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "unmeasured"
              ]
            },
            "status": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "OBSERVED",
                "DERIVED",
                "DERIVED (basis: PROPOSED)",
                "DERIVED (basis: OBSERVED)",
                "PROPOSED",
                null
              ]
            },
            "source": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "description": "Changes its own response with conditions or with what has happened to it."
        },
        "signals": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "value",
            "status",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "unmeasured"
              ]
            },
            "status": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "OBSERVED",
                "DERIVED",
                "DERIVED (basis: PROPOSED)",
                "DERIVED (basis: OBSERVED)",
                "PROPOSED",
                null
              ]
            },
            "source": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "description": "Emits a signal that another part of itself or another organism can read."
        },
        "responds_to_other": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "value",
            "status",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "unmeasured"
              ]
            },
            "status": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "OBSERVED",
                "DERIVED",
                "DERIVED (basis: PROPOSED)",
                "DERIVED (basis: OBSERVED)",
                "PROPOSED",
                null
              ]
            },
            "source": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "description": "Changes what it does in response to another organism."
        },
        "changes_environment": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "value",
            "status",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "unmeasured"
              ]
            },
            "status": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "OBSERVED",
                "DERIVED",
                "DERIVED (basis: PROPOSED)",
                "DERIVED (basis: OBSERVED)",
                "PROPOSED",
                null
              ]
            },
            "source": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "description": "Alters its surroundings in a way that then bears on itself or others."
        },
        "co_adapts": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "value",
            "status",
            "source"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "yes",
                "no",
                "unmeasured"
              ]
            },
            "status": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "OBSERVED",
                "DERIVED",
                "DERIVED (basis: PROPOSED)",
                "DERIVED (basis: OBSERVED)",
                "PROPOSED",
                null
              ]
            },
            "source": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "string"
              }
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "description": "It and a partner each change in response to the other, over repeated contact."
        },
        "coupling_note": {
          "type": [
            "string",
            "null"
          ],
          "description": "What the relation is with (the partner, prey, host, substrate)."
        },
        "contested_label": {
          "description": "Open slot: labels under dispute and who disputes them. Recorded; never required for the yes/no fields, and never changes them.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "required": [
              "label",
              "claimed_by",
              "disputed_by"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "claimed_by": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "disputed_by": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        },
        "notes": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "observation_context": {
      "title": "Observation context",
      "description": "Per claim, the setting in which it was observed. Key = '<block>.<field>' (e.g. 'gate_sensing.response'). Value = lab / field / long_term_coupled / mixed, or null = not known. A lab setting is an observer cut: it removes the loops that run through the organism's environment.",
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": {
        "type": [
          "string",
          "null"
        ],
        "enum": [
          "lab",
          "field",
          "long_term_coupled",
          "mixed",
          null
        ]
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "source": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
