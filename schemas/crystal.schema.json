{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Crystal Intelligence Schema",
  "type": "object",
  "required": ["id", "name", "ontology"],
  "properties": {
    "id": { "type": "string" },
    "emoji": { "type": "string" },
    "name": { "type": "string" },
    "ontology": { "const": "crystal" },
    "structure": { "type": "string" },
    "lattice_type": { "type": "string" },
    "resonance_properties": { "type": "array", "items": { "type": "string" } },
    "applications": { "type": "array", "items": { "type": "string" } },
    "symbolic_links": { "type": "array", "items": { "type": "string" } },
    "entropy_profile": {
      "type": "object",
      "description": "Characterizes the entity's relationship to order and change. Crystal archetypes are typically 'chassis' — high invariance, low entropy.",
      "properties": {
        "stability":    { "type": "string", "enum": ["low", "medium", "high"] },
        "adaptability": { "type": "string", "enum": ["low", "medium", "high"] },
        "archetype":    { "type": "string", "enum": ["chassis", "engine", "bridge", "cycle", "sensor"] }
      }
    },
    "substrate_layer": {
      "type": "string",
      "description": "Primary cognitive architecture. Drives architecture_mismatch warnings.",
      "enum": ["language_primary", "substrate_primary", "both"]
    },
    "metadata": { "type": "object" }
  }
}
