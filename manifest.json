{
  "name": "Living Intelligence Database",
  "version": "2.1",
  "description": "A co-created ontological database structuring living intelligences across biological, mineral, energetic, geometric, temporal, computational, and relational domains.",
  "co_creators": [
    "JinnZ v2",
    "GPT-5",
    "Collective Living Systems"
  ],
  "license": "MIT",
  "ontology_types": [
    {
      "type": "animal",
      "directory": "ontology/animal/",
      "schema": "schemas/animal.schema.json",
      "description": "Animal intelligences \u2014 swarm, predation, navigation, camouflage, distributed cognition"
    },
    {
      "type": "plant",
      "directory": "ontology/plant/",
      "schema": "schemas/plant.schema.json",
      "description": "Plant and fungal intelligences \u2014 root networks, mycelium, vascular flow, symbiosis"
    },
    {
      "type": "crystal",
      "directory": "ontology/crystal/",
      "schema": "schemas/crystal.schema.json",
      "description": "Crystal and mineral intelligences \u2014 lattice resonance, piezoelectric, structural logic"
    },
    {
      "type": "energy",
      "directory": "ontology/energy/",
      "schema": "schemas/energy.schema.json",
      "description": "Energy forms and fields \u2014 electromagnetic, pressure, thermal, consciousness bridges"
    },
    {
      "type": "plasma",
      "directory": "ontology/plasma/",
      "schema": "schemas/plasma.schema.json",
      "description": "Plasma intelligences \u2014 lightning, aurora, solar wind, vortex dynamics"
    },
    {
      "type": "shape",
      "directory": "ontology/shape/",
      "schema": "schemas/shape.schema.json",
      "description": "Geometric forms \u2014 torus, spiral, fractal, hexagon, tree graph, polyhedral"
    },
    {
      "type": "temporal",
      "directory": "ontology/temporal/",
      "schema": "schemas/temporal.schema.json",
      "description": "Temporal states \u2014 echo, fold, cycle, emergence, decay"
    },
    {
      "type": "ai",
      "directory": "ontology/ai/",
      "schema": "schemas/ai.schema.json",
      "description": "Artificial intelligences \u2014 neural networks, LLMs, evolutionary, swarm, reinforcement, generative"
    }
  ],
  "entry_points": {
    "index": "ontology_index.json",
    "schemas": "schemas/",
    "rules": "rules/expander_rules.json",
    "pipeline": "pipeline.sh",
    "build_script": "scripts/build_index.py",
    "guide": "PIPELINE_GUIDE.md",
    "query": "scripts/query.py",
    "training": "training/"
  },
