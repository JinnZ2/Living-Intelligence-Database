    "[ROOT_NET_TREE_GRAPH_FLUX]": ("topology", lambda: GridTopology(10,10)),
    "[CRY_HEX_RESONANCE]": ("chip_arch", lambda: ChipArchitecture("hexagonal")),
    "[QUARTZ_PIEZO_HARMONY]": ("metric", PiezoelectricResonance),
    "[PLASMA_TORUS_FIELD]": ("dynamics", ThermalDiffusion),
    "[LIGHTNING_DISCHARGE_PATH]": ("failure_model", CascadingFailure),
    "[MAG_FIELD_LINE_LOOP]": ("constraint", EnergyConservation),
    "[FLUX_FIELD_FLOW]": ("metric", EntropyProduction),
    "[TORUS_FLOW_CIRCULATION]": ("topology", lambda: TorusTopology()),   # assume we define it
