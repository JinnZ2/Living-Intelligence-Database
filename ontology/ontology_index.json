}

def build_explorer_from_ring(json_path: str) -> List[Experiment]:
    with open(json_path) as f:
        ring = json.load(f)

    entities = {e["id"]: e for e in ring["entities"]}
    experiments = []

    # For each synergy pair, build a comparative experiment
    for rel in ring["relations"]:
        if rel["relation"] != "synergy":
            continue
        src_id = rel["source"]
        tgt_id = rel["target"]
        src = entities[src_id]
        tgt = entities[tgt_id]

        # Attempt to build an experiment for each.
        # Each experiment will use a common perturbation and metrics.
        # We need to instantiate topology, dynamics, etc. from the entities.
        # For simplicity, assume each entity provides a "topology" and optionally
        # a "dynamics" and "failure_model". If missing, use defaults.

        def get_component(entity, type_tag):
            code = entity["symbolic_code"]
            if code in COMPONENT_REGISTRY and COMPONENT_REGISTRY[code][0] == type_tag:
                factory = COMPONENT_REGISTRY[code][1]
                return factory() if callable(factory) else factory
            return None

        topo_src = get_component(src, "topology") or GridTopology(10,10)
        topo_tgt = get_component(tgt, "topology") or GridTopology(10,10)

        dyn_src = get_component(src, "dynamics") or ThermalDiffusion()
        dyn_tgt = get_component(tgt, "dynamics") or ThermalDiffusion()

        # Common perturbation: a localized heat at a central node
        perturbation_src = LocalizedHeat(node=list(topo_src.nodes())[0], energy=100, time=2.0)
        perturbation_tgt = LocalizedHeat(node=list(topo_tgt.nodes())[0], energy=100, time=2.0)

        # Common metrics
        metrics = {"integrity": SignalIntegrity(), "coherence": Coherence()}

        # Failure model: use PhaseTransition by default
        fail_model = PhaseTransition(metric_name="integrity", threshold=0.4)

        # Build two experiments
        exp_src = Experiment(
            topology=topo_src,
            dynamics=dyn_src,
            perturbations=[perturbation_src],
            metrics=metrics,
            failure_model=fail_model,
            constraints=[],
            total_time=50.0
        )
        exp_tgt = Experiment(
            topology=topo_tgt,
            dynamics=dyn_tgt,
            perturbations=[perturbation_tgt],
            metrics=metrics,
            failure_model=fail_model,
            constraints=[],
            total_time=50.0
        )

        experiments.extend([exp_src, exp_tgt])

    return experiments

if __name__ == "__main__":
    experiments = build_explorer_from_ring("symmetry_ring.json")
    sweeper = SweepEngine()
    results = sweeper.run_sweep(lambda: experiments)   # pass them as a list
    sweeper.summary()
